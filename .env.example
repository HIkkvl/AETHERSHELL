# ── База данных ───────────────────────────────────────────────
DB_NAME=AetherShell
DB_USER=postgres
DB_PASSWORD=strong-db-password-here

# ── Сервер ────────────────────────────────────────────────────
# Ключ подписи JWT. Сгенерируйте случайную строку, например:
#   openssl rand -base64 48
SPIK_JWT_SECRET=your-random-64-char-secret-here

# Порт, на котором сервер виден снаружи контейнера
SERVER_PORT=5232

# Публичный адрес сервера: попадает в server.config установщика и в письма
# Пример для локальной сети: http://192.168.1.10:5232
PUBLIC_URL=https://your-domain.com

# Дополнительные origin для CORS. Нужны только для `npm run dev` админ-панели:
# лендинг, кабинет и панель отдаются с того же origin, что и API.
SPIK_CORS_ORIGINS=http://localhost:5173

# ── Платформенный администратор ────────────────────────────────
# Создаётся при первом запуске. Это вход в кабинет: видит все клубы.
AETHER_ADMIN_EMAIL=admin@example.com
AETHER_ADMIN_PASSWORD=strong-password-here

# ── SMTP: письма с доступами владельцам клубов ─────────────────
SPIK_SMTP_HOST=smtp.gmail.com
SPIK_SMTP_PORT=587
SPIK_SMTP_USER=your@gmail.com
SPIK_SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Телеграм-бот (опционально) ─────────────────────────────────
# Бот не стартует по умолчанию. Чтобы включить:
#   docker compose --profile telegram up -d
# и заполните токены ниже.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Общий секрет бота и сервера: по нему сервер принимает нажатия кнопок
# «Принять» и «Отклонить». Без него кнопки будут отвечать ошибкой.
#   openssl rand -hex 32
TG_BOT_SECRET=

# Как часто бот опрашивает новые заявки, секунды
POLL_SECONDS=60
