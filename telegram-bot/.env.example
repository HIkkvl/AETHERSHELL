# Токен бота от @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Чат, куда приходят уведомления о заявках
TG_CHAT_ID=-1001234567890

# URL сервера AetherShell (внутри Docker: http://server:5232, снаружи: https://your-domain.com)
SERVER_URL=http://server:5232

# Платформенный аккаунт: нужен только для чтения списка заявок
AETHER_ADMIN_EMAIL=admin@example.com
AETHER_ADMIN_PASSWORD=change-me

# Общий секрет с сервером: им подписываются нажатия кнопок «Принять» и «Отклонить».
# Такое же значение должно стоять в TG_BOT_SECRET у сервера.
TG_BOT_SECRET=

# Как часто опрашивать сервер, секунды
POLL_SECONDS=60
