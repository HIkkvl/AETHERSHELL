<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AetherShell.Server</RootNamespace>
    <AssemblyName>AetherShell.Server</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  
  <!--
    Публикация одним exe нужна только для установки службой на Windows.
    Включается явно: dotnet publish -c Release -p:WindowsServiceBuild=true.
    Без этого флага собирается обычная переносимая сборка, которой живёт docker-образ.
  -->
  <PropertyGroup Condition="'$(WindowsServiceBuild)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      ASP.NET Core 10 OpenAPI / Swashbuckle 10 собраны под Microsoft.OpenApi 2.x.
      Версия 3.x ломает исходный генератор: IOpenApiMediaType.Example стал read-only.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
  </ItemGroup>

  <!-- Копирование server-settings.json в выходную папку -->
  <ItemGroup>
    <None Update="server-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Сервер отдаёт лендинг, кабинет и админ-панель с того же origin, что и API,
    поэтому статика собирается в wwwroot при сборке.
    Панель попадает сюда только если её предварительно собрали: npm run build в admin-panel.
  -->
  <ItemGroup>
    <AetherLandingFiles Include="$(MSBuildProjectDirectory)/../../AetherMain/**/*" />
    <AetherPanelFiles Include="$(MSBuildProjectDirectory)/../../admin-panel/dist/**/*" />
    <TelegramBotFiles Include="$(MSBuildProjectDirectory)/../../telegram-bot/**/*" Exclude="$(MSBuildProjectDirectory)/../../telegram-bot/**/__pycache__/**;$(MSBuildProjectDirectory)/../../telegram-bot/**/*.pyc;$(MSBuildProjectDirectory)/../../telegram-bot/.env" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="@(TelegramBotFiles)">
      <Link>telegram-bot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyAetherWebAssets" BeforeTargets="Build;Publish">
    <Copy SourceFiles="@(AetherLandingFiles)" DestinationFiles="@(AetherLandingFiles->'$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(AetherLandingFiles)' != ''" />
    <Copy SourceFiles="@(AetherPanelFiles)" DestinationFiles="@(AetherPanelFiles->'$(MSBuildProjectDirectory)/wwwroot/panel/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(AetherPanelFiles)' != ''" />
    <Warning Text="admin-panel не собрана: выполните 'npm ci &amp;&amp; npm run build' в admin-panel, чтобы /panel заработал." Condition="'@(AetherPanelFiles)' == ''" />
  </Target>

</Project>
