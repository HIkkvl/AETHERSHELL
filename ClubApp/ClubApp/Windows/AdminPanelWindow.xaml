<Window x:Class="AetherShell.Client.Windows.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="620" Width="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.8" Color="Black"/>
    </Window.Effect>

    <Window.Resources>
        <Style x:Key="AdminActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#3C2F3D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4A3A4B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdminSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF5ED7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
        </Style>

        <Style x:Key="AdminInput" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#241820"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" BorderThickness="1" Background="#000616">
        <Border.BorderBrush>
            <SolidColorBrush Color="#FF5ED7"/>
        </Border.BorderBrush>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Панель администратора"
                           Foreground="#FF5ED7" FontWeight="Bold" FontSize="18"/>
                <TextBlock x:Name="HeaderInfo"
                           Foreground="#B8A8B8" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="РАБОЧИЙ СТОЛ" Style="{StaticResource AdminSectionTitle}"/>

                    <Button x:Name="BtnUnlockDesktop" Style="{StaticResource AdminActionButton}"
                            Content="Разблокировать рабочий стол" Click="BtnUnlockDesktop_Click"/>
                    <Button x:Name="BtnLockDesktop" Style="{StaticResource AdminActionButton}"
                            Content="Вернуть блокировку" Click="BtnLockDesktop_Click"/>
                    <Button x:Name="BtnTaskManager" Style="{StaticResource AdminActionButton}"
                            Content="Диспетчер задач" Click="BtnTaskManager_Click"/>
                    <Button x:Name="BtnExplorer" Style="{StaticResource AdminActionButton}"
                            Content="Проводник" Click="BtnExplorer_Click"/>

                    <TextBlock Text="СЕССИЯ" Style="{StaticResource AdminSectionTitle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MinutesBox" Text="60" Style="{StaticResource AdminInput}"/>
                        <Button x:Name="BtnStartSession" Grid.Column="1" Width="150" Margin="8,0,0,0"
                                Style="{StaticResource AdminActionButton}"
                                HorizontalContentAlignment="Center"
                                Content="Выдать время" Click="BtnStartSession_Click"/>
                    </Grid>

                    <Button x:Name="BtnStopSession" Style="{StaticResource AdminActionButton}"
                            Content="Завершить сессию" Click="BtnStopSession_Click"/>

                    <TextBlock Text="БАЛАНС КЛИЕНТА" Style="{StaticResource AdminSectionTitle}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AmountBox" Text="1000" Style="{StaticResource AdminInput}"/>
                        <Button x:Name="BtnTopUp" Grid.Column="1" Width="150" Margin="8,0,0,0"
                                Style="{StaticResource AdminActionButton}"
                                HorizontalContentAlignment="Center"
                                Content="Пополнить" Click="BtnTopUp_Click"/>
                    </Grid>

                    <TextBlock Text="ПИТАНИЕ И ШЕЛЛ" Style="{StaticResource AdminSectionTitle}"/>

                    <Button x:Name="BtnReboot" Style="{StaticResource AdminActionButton}"
                            Content="Перезагрузить компьютер" Click="BtnReboot_Click"/>
                    <Button x:Name="BtnShutdown" Style="{StaticResource AdminActionButton}"
                            Content="Выключить компьютер" Click="BtnShutdown_Click"/>
                    <Button x:Name="BtnExitShell" Style="{StaticResource AdminActionButton}"
                            Background="#5A1E1E"
                            Content="Выйти из шелла" Click="BtnExitShell_Click"/>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="StatusText" Grid.Row="2"
                       Foreground="#A299B8" FontSize="12"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>

            <Button Grid.Row="3" Content="Закрыть" Click="BtnClose_Click"
                    Height="38" Margin="0,12,0,0" Cursor="Hand" Foreground="White" FontSize="13">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
