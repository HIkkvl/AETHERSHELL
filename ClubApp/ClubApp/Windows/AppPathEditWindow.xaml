<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AetherShell.Client.Windows.AppPathEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Путь запуска" Height="250" Width="500"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" Topmost="True">
  <Border CornerRadius="12" BorderThickness="1" Background="#F00A0612" BorderBrush="#1FFFFFFF" Padding="24">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
    <StackPanel>
      <TextBlock Text="Путь к приложению / игре" Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14"/>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                CornerRadius="8" Height="40" Padding="12,0">
          <TextBox Name="PathBox" FontSize="13"
                   Background="Transparent" Foreground="White" BorderThickness="0"
                   CaretBrush="#BF5AF2" VerticalContentAlignment="Center"/>
        </Border>
        <Button Grid.Column="1" Content="…" Width="44" Height="40" Margin="8,0,0,0"
                Cursor="Hand" Foreground="White" Click="BtnBrowse_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                      BorderThickness="1" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
      <TextBlock Text="Можно указать .exe, .lnk или steam://rungameid/…" Foreground="#A299B8" FontSize="11" Margin="0,0,0,18"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Сохранить" Width="120" Height="36" Margin="0,0,8,0"
                Cursor="Hand" Foreground="White" FontSize="13" Click="BtnOk_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="#FC5ED8" CornerRadius="8">
                <Border.Effect>
                  <DropShadowEffect Color="#FB5ED8" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button Content="Отмена" Width="100" Height="36"
                Cursor="Hand" Foreground="White" FontSize="13" Click="BtnCancel_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                      BorderThickness="1" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
