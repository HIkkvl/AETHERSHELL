<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AetherShell.Client.Windows.ExitPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Высокий доступ" Height="230" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="12" BorderThickness="1" Background="#F00A0612" BorderBrush="#1FFFFFFF" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Пароль высокого доступа"
                       Foreground="White" FontWeight="SemiBold" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    CornerRadius="8" Height="40" Margin="0,0,0,20" Padding="12,0">
                <PasswordBox x:Name="PasswordBox"
                             FontSize="14"
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             CaretBrush="#BF5AF2" PasswordChar="●"
                             VerticalContentAlignment="Center"
                             KeyDown="PasswordBox_KeyDown"/>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnOk" Content="OK" Click="BtnOk_Click"
                        Width="110" Height="36" Margin="8,0" Cursor="Hand" Foreground="White" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#FC5ED8" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FB5ED8" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click"
                        Width="110" Height="36" Margin="8,0" Cursor="Hand" Foreground="White" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                                    BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
