<Window x:Class="AetherShell.Client.Windows.AdminLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Режим администратора" Height="340" Width="420"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="12" BorderThickness="1" Background="#F00A0612" BorderBrush="#1FFFFFFF" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Режим администратора"
                       Foreground="White" FontWeight="SemiBold" FontSize="18"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="1"
                       Text="Войдите учётной записью сотрудника зала"
                       Foreground="#A299B8" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,8,0,20"/>

            <Border Grid.Row="2" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    CornerRadius="8" Height="40" Margin="0,0,0,12" Padding="12,0">
                <TextBox x:Name="LoginBox"
                         FontSize="14"
                         Background="Transparent" Foreground="White" BorderThickness="0"
                         CaretBrush="#BF5AF2" VerticalContentAlignment="Center"
                         KeyDown="Field_KeyDown"/>
            </Border>

            <Border Grid.Row="3" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    CornerRadius="8" Height="40" Margin="0,0,0,12" Padding="12,0">
                <PasswordBox x:Name="PasswordBox"
                             FontSize="14"
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             CaretBrush="#BF5AF2" PasswordChar="●"
                             VerticalContentAlignment="Center"
                             KeyDown="Field_KeyDown"/>
            </Border>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="4"
                       Foreground="#FF6B6B" FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="Collapsed"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnOk" Content="Войти" Click="BtnOk_Click"
                        Width="120" Height="36" Margin="8,0" Cursor="Hand" Foreground="White" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#FC5ED8" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FB5ED8" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnCancel" Content="Отмена" Click="BtnCancel_Click"
                        Width="120" Height="36" Margin="8,0" Cursor="Hand" Foreground="White" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                                    BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
