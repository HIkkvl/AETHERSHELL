<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AetherShell.Client.ShellTaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AetherShell Taskbar"
        Height="48" Width="1920"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Loaded="Window_Loaded">
  <Border Name="TaskbarRoot"
          Background="#05FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
    <Grid>
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    PanningMode="HorizontalOnly" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="160,0" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
        <ItemsControl Name="AppsList" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Width="40" Height="40" Margin="2,0" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Title}" Click="AppButton_Click">
                <Button.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="Bg" CornerRadius="8" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="#00FFFFFF">
                      <Image Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Icon}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Bg" Property="Border.Background" Value="#14FFFFFF" />
                      </Trigger>
                      <DataTrigger Value="True" Binding="{Binding IsActive}">
                        <Setter TargetName="Bg" Property="Border.Background" Value="#1AFFFFFF" />
                        <Setter TargetName="Bg" Property="Border.BorderBrush" Value="#FF5ED7" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <Button Name="BtnKeyboardLayout" MinWidth="44" Height="32" Margin="0,0,4,0" Cursor="Hand"
                ToolTip="Сменить раскладку (Win+Space)" VerticalAlignment="Center" Click="KeyboardLayout_Click">
          <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" CornerRadius="8" Background="Transparent" Padding="8,0">
                <TextBlock Foreground="#A299B8" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#14FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Button Name="BtnVolume" Width="36" Height="32" Margin="0,0,6,0" Cursor="Hand"
                ToolTip="Громкость (ПКМ — выкл. звук)" VerticalAlignment="Center"
                Click="Volume_Click" MouseRightButtonUp="Volume_RightClick" PreviewMouseWheel="Volume_MouseWheel">
          <Button.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bg" CornerRadius="8" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Border.Background" Value="#14FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Grid Width="20" Height="20">
            <Path Name="IconVolume" Fill="#A299B8" Stretch="Uniform" Width="18" Height="18"
                  Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M14.5,12 C14.5,10.5 13.7,9.2 12.5,8.5 V15.5 C13.7,14.8 14.5,13.5 14.5,12 Z M12.5,6.1 C14.9,7 16.5,9.3 16.5,12 C16.5,14.7 14.9,17 12.5,17.9 V16.1 C14,15.3 15,13.8 15,12 C15,10.2 14,8.7 12.5,7.9 V6.1 Z"/>
            <Path Name="IconMuted" Fill="#A299B8" Stretch="Uniform" Width="18" Height="18" Visibility="Collapsed"
                  Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,9.5 L15.1,8.1 L13,10.2 L10.9,8.1 L9.5,9.5 L11.6,11.6 L9.5,13.7 L10.9,15.1 L13,13 L15.1,15.1 L16.5,13.7 L14.4,11.6 Z"/>
          </Grid>
        </Button>

        <Popup Name="VolumePopup" PlacementTarget="{Binding ElementName=BtnVolume}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
          <Border Background="#F00A0612" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,16"
                  Width="72">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Name="VolumePercentText" Text="50%" Foreground="White" FontSize="12" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Margin="0,0,0,10"/>
              <Slider Name="VolumeSlider" Orientation="Vertical" Height="120" Minimum="0" Maximum="100"
                      TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                      Foreground="#FF5ED7" ValueChanged="VolumeSlider_ValueChanged"/>
              <Button Name="BtnMuteToggle" Margin="0,12,0,0" Width="36" Height="28" Cursor="Hand"
                      ToolTip="Выкл. / вкл. звук" Click="MuteToggle_Click">
                <Button.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="Bg" CornerRadius="6" Background="#14FFFFFF">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="Bg" Property="Border.Background" Value="#28FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <TextBlock Name="MuteGlyph" Text="🔊" FontSize="12"/>
              </Button>
            </StackPanel>
          </Border>
        </Popup>

        <TextBlock Name="ClockText" Foreground="#A299B8" FontSize="13" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="4,0,4,0" Text="00:00" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
