<Page x:Class="AetherShell.Client.Pages.FoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:utils="clr-namespace:AetherShell.Client.Utils"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="FoodPage"
      Background="Transparent">

    <Page.Resources>
        <utils:ImageUrlConverter x:Key="ImageUrlConverter"/>

        <Style x:Key="ProductCardStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="340"/>
            <Setter Property="Margin" Value="15,15,15,30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            
                            <Border x:Name="ShadowBorder"
                                    Background="#342735"
                                    CornerRadius="30"
                                    BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="4" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="ContentBorder"
                                    Background="#241820"
                                    CornerRadius="30"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ShadowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF5ED7" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ContentBorder" Property="BorderBrush" Value="#FF5ED7"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#3C2F3D"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Width" Value="175"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,44,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddToCartButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF5ED7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartAnimatedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BtnBorder" Background="#FF5ED7" CornerRadius="25,25,25,25" Width="165" Height="66" Margin="-44,0,0,0" Padding="20,12" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="MoveTransform" X="0"/>
                                </Border.RenderTransform>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CartIcon" Text="🛒" FontSize="20" Margin="4,6,0,0" Foreground="#FFFFFF"/>
                                    <TextBlock x:Name="BtnText" Text="Корзина" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="3" FontWeight="Bold" FontSize="15"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MoveTransform" Storyboard.TargetProperty="X" To="15" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="MoveTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <PathGeometry x:Key="IconSearch" Figures="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        <PathGeometry x:Key="IconTrash" Figures="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PageTitle" Text="Еда" Foreground="White" FontSize="40" FontWeight="Bold" Margin="60,40,0,20"/>

        <Grid Grid.Row="0" Margin="10,40,60,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#3C2F3D" CornerRadius="25" Width="300" Height="50" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconSearch}" Fill="#AAAAAA" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" CaretBrush="White" TextChanged="SearchTextBox_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="Поиск..." Foreground="#555555" FontSize="16" VerticalAlignment="Center" Grid.Column="1" Margin="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="30,0,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              PanningMode="HorizontalOnly"
                              
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.99"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>

                    <StackPanel x:Name="CategoriesPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource ProductCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Margin="0,0,0,10" CornerRadius="30,30,30,30">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding ImageUrl, Converter={StaticResource ImageUrlConverter}}" 
                                                    Stretch="UniformToFill"
                                                    AlignmentX="Center"
                                                    AlignmentY="Center"/>
                                    </Border.Background>
                                </Border>

                                <TextBlock Grid.Row="1" 
                                           Text="{Binding Name}" 
                                           Foreground="White" 
                                           FontWeight="Normal" 
                                           FontSize="20" 
                                           TextAlignment="Center" 
                                           TextWrapping="Wrap"
                                           Margin="15,0,15,10"/>

                                <Grid Grid.Row="2" Margin="20,0,20,25">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                        <TextBlock Text="{Binding Price}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                                        <TextBlock Text=" тг" Foreground="White" FontSize="16" FontWeight="Normal" Margin="3,0,0,4" VerticalAlignment="Bottom"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" 
                                            Content="В корзину" 
                                            Style="{StaticResource AddToCartButtonStyle}" 
                                            Click="AddToCart_Click" 
                                            Tag="{Binding}"/>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button x:Name="CartButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-15,0,0,98" Style="{StaticResource CartAnimatedButtonStyle}" Click="CartButton_Click" Panel.ZIndex="10" Grid.Row="1" Visibility="Visible"/>

        <Border x:Name="CartPopup" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="257" Margin="-39,0,0,100" Background="#241820" BorderBrush="#FF5ED7" Opacity="0.96" BorderThickness="1" CornerRadius="23" Visibility="Collapsed" Panel.ZIndex="100">
            <Grid Margin="15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Корзина" Foreground="White" FontSize="20" FontWeight="Normal"/>
                    <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Content="✕" Foreground="White" FontSize="18" Cursor="Hand" Click="CloseCart_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl x:Name="CartListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" 
                                        BorderBrush="#FF5ED7" 
                                        Margin="0,0,0,10" 
                                        Padding="0,0,0,10">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True" Height="60" Width="60" Background="#222">
                                            <Image Source="{Binding Product.ImageUrl, Converter={StaticResource ImageUrlConverter}}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Product.Name}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Product.Price, StringFormat={}{0} тг}" Foreground="#FF5ED7" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat={}x{0}}" Foreground="#FF5ED7" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>

                                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="RemoveItem_Click" Tag="{Binding}">
                                            <Path Data="{StaticResource IconTrash}" Fill="#FF4444" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Height="1" Background="#FF5ED7" Margin="0,10,0,10"/>

                <StackPanel Grid.Row="3">
                    <TextBlock x:Name="TotalText" Text="Итог: 3000 тг" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Button Content="Купить" Width="100" Height="24" Background="#FF5ED7" Foreground="White" FontWeight="Bold" FontSize="14" Click="Checkout_Click" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>