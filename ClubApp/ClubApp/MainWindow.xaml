            <RowDefinition Height="48"/>
          </Grid.RowDefinitions>
          <Grid Background="#0AFFFFFF">
            <TextBlock Text="Карта клуба — выбрать ПК" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button Content="✕" HorizontalAlignment="Right" Width="50" Height="50"
                    Background="Transparent" Foreground="#A299B8" BorderThickness="0"
                    Style="{StaticResource NoHoverButtonStyle}" Click="BtnCloseClubMap_Click"/>
          </Grid>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,12,20,8">
            <Ellipse Width="10" Height="10" Fill="#3DDC97" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Свободен" Foreground="#A299B8" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Ellipse Width="10" Height="10" Fill="#FF5ED7" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Занят" Foreground="#A299B8" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Ellipse Width="10" Height="10" Fill="#666" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Оффлайн" Foreground="#A299B8" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <Ellipse Width="10" Height="10" Fill="#4FC3F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Вы здесь" Foreground="#A299B8" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="Обновить" HorizontalAlignment="Right" Margin="24,0,0,0" Padding="12,6"
                    Background="#14FFFFFF" Foreground="White" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    Cursor="Hand" Click="BtnRefreshClubMap_Click"/>
          </StackPanel>
          <Border Grid.Row="2" Margin="16,0,16,8" Background="#08050C" CornerRadius="10" BorderBrush="#1FFFFFFF" BorderThickness="1" ClipToBounds="True">
            <Canvas Name="ClubMapCanvas" SizeChanged="ClubMapCanvas_SizeChanged"/>
          </Border>
          <TextBlock Grid.Row="3" Name="ClubMapHint" Text="Нажмите на свободный ПК, чтобы перенести сессию"
                     Foreground="#A299B8" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
    <Grid Name="InputOverlay" Row="0" RowSpan="2" Column="0" ColumnSpan="3" Visibility="Collapsed" Background="#CC040208" Panel.ZIndex="1000">
      <Border Width="480" MinHeight="220" Background="#F00A0612" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="28">
        <StackPanel>
          <TextBlock Name="InputTitle" Text="Заголовок" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
          <TextBlock Name="InputMessage" Text="Сообщение" Foreground="#A299B8" HorizontalAlignment="Center" Margin="0,0,0,18" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
          <Border CornerRadius="8" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Margin="0,0,0,20" Height="42" Padding="12,0">
            <TextBox Name="InputTextBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" CaretBrush="#BF5AF2" VerticalContentAlignment="Center" TextAlignment="Center" />
          </Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Отмена" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource ModalButtonSecondary}" Click="BtnInputCancel_Click" />
            <Button Content="ОК" Width="110" Height="38" Style="{StaticResource ModalButton}" Click="BtnInputOk_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Name="ConfirmationOverlay" Row="0" RowSpan="2" Column="0" ColumnSpan="3" Visibility="Collapsed" Background="#CC040208" Panel.ZIndex="1000">
      <Border Width="480" MinHeight="180" Background="#F00A0612" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="28">
        <StackPanel>
          <TextBlock Name="MsgTitle" Text="Подтверждение" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10" />
          <TextBlock Name="MsgContent" Text="?" Foreground="#A299B8" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" FontSize="13" Margin="0,0,0,22" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="BtnMsgNo" Content="Нет" Width="110" Height="38" Margin="0,0,10,0" Style="{StaticResource ModalButtonSecondary}" Click="BtnMsgClose_Click" />
            <Button Name="BtnMsgYes" Content="Да" Width="110" Height="38" Style="{StaticResource ModalButton}" Click="BtnMsgYes_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Name="IdleOverlay" Row="0" RowSpan="2" Column="0" ColumnSpan="3" Visibility="Collapsed" Background="#FF000000" Panel.ZIndex="2000">
      <Image Source="pack://application:,,,/Images/background_waves.png" Stretch="UniformToFill" />
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60">
        <TextBlock Text="Компьютер" Foreground="#888" FontSize="24" FontWeight="Light" />
        <TextBlock Name="IdlePcNameText" Text="PC-01" Foreground="#FFFFFFFF" FontSize="60" FontWeight="Bold">
          <UIElement.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" />
          </UIElement.Effect>
        </TextBlock>
      </StackPanel>
      <Image Source="pack://application:,,,/Images/logo.png" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
        <UIElement.Effect>
          <DropShadowEffect Color="#FF5ED7" BlurRadius="60" Opacity="0.4" />
        </UIElement.Effect>
      </Image>
      <TextBlock Text="Коснитесь экрана или мыши, чтобы начать" Foreground="#888" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150" Opacity="0.7" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="60">
        <TextBlock Name="IdleClockText" Text="00:00" Foreground="#FFFFFFFF" FontSize="140" FontWeight="Thin" HorizontalAlignment="Right" LineHeight="120" />
        <TextBlock Name="IdleDateText" Text="1 января" Foreground="#CCC" FontSize="36" HorizontalAlignment="Right" Margin="0,-20,5,0" />
      </StackPanel>
    </Grid>
    <Grid Name="PendingApprovalOverlay" Row="0" RowSpan="2" Column="0" ColumnSpan="3" Visibility="Collapsed" Background="#EE241820" Panel.ZIndex="3000">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Images/logo.png" Width="180" Margin="0,0,0,40" RenderOptions.BitmapScalingMode="HighQuality">
          <UIElement.Effect>
            <DropShadowEffect Color="#FF5ED7" BlurRadius="40" Opacity="0.5" />
          </UIElement.Effect>
        </Image>
        <TextBlock Text="⏳" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,20" />
        <TextBlock Text="Ожидание подтверждения" Foreground="#FFFFFFFF" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" />
        <TextBlock Text="Этот компьютер ещё не подтверждён администратором." Foreground="#AAA" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10" />
        <TextBlock Text="Пожалуйста, подождите или обратитесь к администратору." Foreground="#888" FontSize="16" HorizontalAlignment="Center" />
        <Border Background="#20FFD700" CornerRadius="10" Padding="20,15" Margin="0,40,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="ID компьютера: " Foreground="#AAA" FontSize="16" />
            <TextBlock Name="PendingPcIdText" Foreground="#FF5ED7" FontSize="16" FontWeight="Bold" Text="{Binding MyPcId}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Border Name="OfflineIndicator" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" Panel.ZIndex="2500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,20,0" Background="#EE1A1A1A" CornerRadius="10" Padding="15,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel>
          <TextBlock Text="Нет связи с сервером" Foreground="#FF6B6B" FontSize="14" FontWeight="Bold" />
          <TextBlock Text="Таймер работает локально" Foreground="#AAA" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>