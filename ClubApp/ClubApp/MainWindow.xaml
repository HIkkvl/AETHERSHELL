    </Grid>
    <Grid Name="IdleOverlay" Row="0" RowSpan="2" Column="0" ColumnSpan="2" Visibility="Collapsed" Background="#FF000000" Panel.ZIndex="2000">
      <Image Source="pack://application:,,,/Images/background_waves.png" Stretch="UniformToFill" />
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60">
        <TextBlock Text="Компьютер" Foreground="#888" FontSize="24" FontWeight="Light" />
        <TextBlock Name="IdlePcNameText" Text="PC-01" Foreground="#FFFFFFFF" FontSize="60" FontWeight="Bold">
          <UIElement.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5" />
          </UIElement.Effect>
        </TextBlock>
      </StackPanel>
      <Image Source="pack://application:,,,/Images/logo.png" Width="280" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
        <UIElement.Effect>
          <DropShadowEffect Color="#FF5ED7" BlurRadius="60" Opacity="0.4" />
        </UIElement.Effect>
      </Image>
      <TextBlock Text="Коснитесь экрана или мыши, чтобы начать" Foreground="#888" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,150" Opacity="0.7" />
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="60">
        <TextBlock Name="IdleClockText" Text="00:00" Foreground="#FFFFFFFF" FontSize="140" FontWeight="Thin" HorizontalAlignment="Right" LineHeight="120" />
        <TextBlock Name="IdleDateText" Text="1 января" Foreground="#CCC" FontSize="36" HorizontalAlignment="Right" Margin="0,-20,5,0" />
      </StackPanel>
    </Grid>
    <Grid Name="PendingApprovalOverlay" Row="0" RowSpan="2" Column="0" ColumnSpan="2" Visibility="Collapsed" Background="#EE241820" Panel.ZIndex="3000">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Images/logo.png" Width="180" Margin="0,0,0,40" RenderOptions.BitmapScalingMode="HighQuality">
          <UIElement.Effect>
            <DropShadowEffect Color="#FF5ED7" BlurRadius="40" Opacity="0.5" />
          </UIElement.Effect>
        </Image>
        <TextBlock Text="⏳" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,20" />
        <TextBlock Text="Ожидание подтверждения" Foreground="#FFFFFFFF" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" />
        <TextBlock Text="Этот компьютер ещё не подтверждён администратором." Foreground="#AAA" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,10" />
        <TextBlock Text="Пожалуйста, подождите или обратитесь к администратору." Foreground="#888" FontSize="16" HorizontalAlignment="Center" />
        <Border Background="#20FFD700" CornerRadius="10" Padding="20,15" Margin="0,40,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="ID компьютера: " Foreground="#AAA" FontSize="16" />
            <TextBlock Name="PendingPcIdText" Foreground="#FF5ED7" FontSize="16" FontWeight="Bold" Text="{Binding MyPcId}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    <Border Name="OfflineIndicator" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="2500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,20,0" Background="#EE1A1A1A" CornerRadius="10" Padding="15,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
        <StackPanel>
          <TextBlock Text="Нет связи с сервером" Foreground="#FF6B6B" FontSize="14" FontWeight="Bold" />
          <TextBlock Text="Таймер работает локально" Foreground="#AAA" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>