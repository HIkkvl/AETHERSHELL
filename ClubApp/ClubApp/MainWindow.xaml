               Canvas.Left="520" Canvas.Top="520">
        <Ellipse.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="SessionBlob5Scale" ScaleX="1" ScaleY="1" CenterX="240" CenterY="240"/>
