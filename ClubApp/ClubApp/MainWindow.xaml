                                      </StackPanel>
                                      <StackPanel Orientation="Horizontal">
                                        <Path Name="CheckIcon2" Data="{StaticResource IconCheck}" Fill="#FF5ED7" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" Stretch="Uniform" />
                                        <TextBlock Name="FeatureText2" Foreground="#FFFFFFFF" FontSize="14" VerticalAlignment="Center" Text="{Binding Feature2}" />
                                      </StackPanel>
                                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Path Data="{StaticResource IconCheck}" Fill="#FF5ED7" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" Stretch="Uniform" />
                                        <TextBlock Foreground="#FF5ED7" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding BurnLabel}" />
                                      </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,12">
