<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AetherShell.Client.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:utils="clr-namespace:AetherShell.Client.Utils" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="AetherShell" Height="1080" Width="1920" WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize" Background="{StaticResource AppBackgroundBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <utils:ImageUrlConverter x:Key="ImageUrlConverter" />
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <SolidColorBrush x:Key="PanelGlassBrush" Color="#B3342735" />
      <SolidColorBrush x:Key="AccentGoldBrush" Color="#FF5ED7" />
      <SolidColorBrush x:Key="SecondaryGoldBrush" Color="#E04BC0" />
      <SolidColorBrush x:Key="TextGrayBrush" Color="#B8A8B8" />
      <SolidColorBrush x:Key="TextWhiteBrush" Color="White" />
      <Geometry x:Key="IconSend">M2.01 21L23 12 2.01 3 2 10l15 2-15 2z</Geometry>
      <Geometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
      <Geometry x:Key="IconLock">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</Geometry>
      <Geometry x:Key="IconExit">M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z</Geometry>
      <Style x:Key="ChatAnimatedButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="BtnBorder" Background="#342735" BorderBrush="#4FFFFFFF" BorderThickness="1" CornerRadius="25" Width="168" Height="56" Margin="0,0,-17,0" Padding="18,10" RenderTransformOrigin="1,0.5">
                  <UIElement.RenderTransform>
                    <TranslateTransform x:Name="MoveTransform" X="0" />
                  </UIElement.RenderTransform>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="💬" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Name="BtnText" Text="Чат с админом" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="MoveTransform" Storyboard.TargetProperty="X" To="-14" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="MoveTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BtnBorder" Property="Border.Background" Value="#3C2F3D" />
                  <Setter TargetName="BtnBorder" Property="Border.BorderBrush" Value="#FF5ED7" />
                  <Setter TargetName="BtnText" Property="TextBlock.Foreground" Value="#FF5ED7" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BtnBorder" Property="Border.Background" Value="#2A1F2B" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ChatScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollViewer}">
              <Grid>
                <ScrollContentPresenter />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NoHoverButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="UIElement.Opacity" Value="0.7" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModalButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{StaticResource AccentGoldBrush}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModalButtonSecondary" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#FF808080" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#33FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShellIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="#00FFFFFF">
                <Path Name="IconPath" Fill="#555555" Stretch="Uniform" Margin="10" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="IconPath" Property="Shape.Fill" Value="{StaticResource AccentGoldBrush}" />
                  <Setter TargetName="IconPath" Property="UIElement.Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#FF5ED7" BlurRadius="10" ShadowDepth="0" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShellImageButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="#00FFFFFF">
                <Image Name="IconImage" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="IconImage" Property="UIElement.Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#FF5ED7" BlurRadius="10" ShadowDepth="0" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShellActiveButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="60" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="BtnBorder" CornerRadius="12">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#E6D395" Offset="0" />
                    <GradientStop Color="#BCA05A" Offset="0.5" />
                    <GradientStop Color="#7D6220" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <UIElement.Effect>
                  <DropShadowEffect Color="#FF5ED7" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                </UIElement.Effect>
                <Path Fill="#FF000000" Stretch="Uniform" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BtnBorder" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InputBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#241820" />
        <Setter Property="Border.CornerRadius" Value="12" />
        <Setter Property="Height" Value="58" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="OldActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryPinkButtonStyle}">
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,8,0,0" />
      </Style>
      <Style x:Key="NeonLineStyle" TargetType="{x:Type Path}">
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Shape.Stretch" Value="Fill" />
        <Setter Property="Shape.StrokeStartLineCap" Value="Round" />
        <Setter Property="Shape.StrokeEndLineCap" Value="Round" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <BlurEffect Radius="25" KernelType="Gaussian" />
          </Setter.Value>
        </Setter>
      </Style>
      <LinearGradientBrush x:Key="GoldCardGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#EEDCA6" Offset="0.0" />
        <GradientStop Color="#FF5ED7" Offset="0.5" />
        <GradientStop Color="#BF9336" Offset="1.0" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Name="RootShellGrid" Background="{StaticResource AppBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#CC241820" BorderBrush="#4FFFFFFF" BorderThickness="0,0,0,1" Panel.ZIndex="100" Padding="28,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Padding="0" Margin="0,0,28,0" ToolTip="Приложения" Click="Nav_Apps_Click">
            <Image Source="pack://application:,,,/Images/logo_menu.png" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
          </Button>
          <Button Name="BtnNavApps" Content="Приложения" Style="{StaticResource ShellNavTabActiveStyle}" Click="Nav_Apps_Click" />
          <Button Name="BtnNavGames" Content="Игры" Style="{StaticResource ShellNavTabStyle}" Click="Nav_Games_Click" />
          <Button Name="BtnNavTariffs" Content="Тарифы" Style="{StaticResource ShellNavTabStyle}" Click="Nav_Tariffs_Click" />
          <Button Name="BtnNavFood" Content="Еда" Style="{StaticResource ShellNavTabStyle}" Click="Nav_Food_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource ShellIconButtonStyle}" Tag="{StaticResource IconChat}" ToolTip="Чат с админом" Margin="0,0,8,0" Click="BtnToggleChat_Click" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,16,0">
            <Ellipse Width="8" Height="8" Fill="#FF5ED7" Margin="0,0,8,0" />
            <TextBlock Name="TopPcZoneText" Text="pc" Foreground="#C8C8D0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Button Style="{StaticResource ShellIconButtonStyle}" Tag="{StaticResource IconLock}" ToolTip="Выйти / блокировка" Margin="0,0,4,0" Click="BtnLogout_Click" />
          <Button Style="{StaticResource ShellIconButtonStyle}" Tag="{StaticResource IconExit}" ToolTip="Выход" Click="BtnLogout_Click" />
        </StackPanel>
      </Grid>
    </Border>
    <Frame Name="MainFrame" Grid.Row="1" Grid.Column="0" NavigationUIVisibility="Hidden" Margin="16,12,8,24" />
    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,12,20,24">
      <StackPanel>
        <Border Margin="0,0,0,12" Background="#3C2F3D" CornerRadius="18" Padding="18" BorderThickness="1.5">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF5ED7" Offset="0" />
              <GradientStop Color="#8B3A7A" Offset="0.55" />
              <GradientStop Color="#FF5ED7" Offset="1" />
            </LinearGradientBrush>
          </Border.BorderBrush>
          <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
              <Grid Width="44" Height="44" Margin="0,0,10,0">
                <Border CornerRadius="8" Background="#3C2F3D" ClipToBounds="True">
                  <Grid>
                    <TextBlock Name="SidebarAvatar" Text="?" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Name="SidebarAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                  </Grid>
                </Border>
                <Button Name="BtnEditAvatar" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Cursor="Hand" ToolTip="Сменить аватар" Background="#FF5ED7" BorderThickness="0" Padding="0" Click="BtnEditAvatar_Click">
                  <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}" CornerRadius="10" Width="20" Height="20">
                        <TextBlock Text="✎" Foreground="#FFFFFFFF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                      </Border>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
              <TextBlock Name="SidebarUsername" Text="..." Foreground="#C8C8D0" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="SidebarSessionLabel" Text="Активна - осталось" Foreground="#FFFFFFFF" FontSize="13" HorizontalAlignment="Center" />
            <TextBlock Name="SidebarTimer" Text="00:00:00" Foreground="#FFFFFFFF" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,8" />
            <TextBlock Name="SidebarTariffHint" Text="Тариф: —" Foreground="#B8A8B8" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <TextBlock Name="DiscountText" Text="0%" Visibility="Collapsed" />
        <Border Style="{StaticResource GlassPanelStyle}" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Баланс:" Foreground="#B8A8B8" FontSize="12" />
            <TextBlock Name="SidebarBalance" Text="0 ₸" Foreground="#FFFFFFFF" FontSize="28" FontWeight="Bold" Margin="0,6,0,14" />
            <TextBlock Text="Пополнить:" Foreground="#B8A8B8" FontSize="12" Margin="0,0,0,8" />
            <Border Background="#241820" CornerRadius="10" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
              <TextBox Name="TopUpAmountBox" Background="#00FFFFFF" BorderThickness="0" Foreground="#FFFFFFFF" FontSize="14" CaretBrush="#FFFFFFFF" Text="" />
            </Border>
            <TextBlock IsHitTestVisible="False" Text="Введите сумму" Foreground="#555" FontSize="13" Margin="14,-44,0,28">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="" Binding="{Binding Text, ElementName=TopUpAmountBox}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </TextBlock>
            <Button Content="Пополнить" Style="{StaticResource PrimaryPinkButtonStyle}" Click="BtnTopUp_Click" />
          </StackPanel>
        </Border>
        <ProgressBar Name="LoyaltyProgress" Height="3" Margin="4,0,4,12" Background="#3C2F3D" Foreground="#FF5ED7" BorderThickness="0" Visibility="Collapsed" />
        <Border Name="BannerContainer" Visibility="Collapsed" Margin="0,0,0,12" Height="220" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1">
          <Grid>
            <UIElement.OpacityMask>
              <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                <VisualBrush.Visual>
                  <Border Background="#FF000000" CornerRadius="15.5" Width="{Binding ActualWidth, ElementName=BannerContainer}" Height="{Binding ActualHeight, ElementName=BannerContainer}" />
                </VisualBrush.Visual>
              </VisualBrush>
            </UIElement.OpacityMask>
            <Grid ClipToBounds="True">
              <Canvas Name="BannerCanvas">
                <Image Name="CurrentBannerImg" Width="270" Height="218" Stretch="UniformToFill" Canvas.Left="0" />
                <Image Name="NextBannerImg" Width="270" Height="218" Stretch="UniformToFill" Canvas.Left="0" />
              </Canvas>
              <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Width="{Binding ActualWidth, ElementName=BannerContainer}" Height="{Binding ActualHeight, ElementName=BannerContainer}" Click="PromoBanner_Click">
                <Button.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="#00FFFFFF" />
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Name="LockedScreen" Row="0" RowSpan="2" Column="0" ColumnSpan="2" Visibility="Visible" Panel.ZIndex="500" Background="#FF000000">
      <Grid Name="AuthContentLayer" Background="{StaticResource AppBackgroundBrush}">
        <!-- Soft ambient glow -->
        <Ellipse Width="720" Height="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-120,0,0" IsHitTestVisible="False" Opacity="0.35">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#66FF5ED7" Offset="0"/>
              <GradientStop Color="#00FF5ED7" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect>
            <BlurEffect Radius="80"/>
          </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-120,0,0,-80" IsHitTestVisible="False" Opacity="0.22">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#558B3A7A" Offset="0"/>
              <GradientStop Color="#008B3A7A" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect>
            <BlurEffect Radius="60"/>
          </Ellipse.Effect>
        </Ellipse>

        <TextBlock Name="PcNameText" Text="..." FontSize="28" FontWeight="SemiBold"
                   Foreground="#55FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="36,28,0,0"/>
        <TextBlock Name="BigClockTime" Text="00:00" FontSize="56" FontWeight="Bold"
                   Foreground="#40FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,40,28"/>

        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="440"
                Background="#CC342735" BorderBrush="#4FFFFFFF" BorderThickness="1"
                CornerRadius="22" Padding="36,32">
          <Border.Effect>
            <DropShadowEffect Color="#FF5ED7" BlurRadius="36" ShadowDepth="0" Opacity="0.18"/>
          </Border.Effect>
          <StackPanel>
            <Image Source="pack://application:,,,/Images/logo_menu.png" Width="56" Height="56"
                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,0,10"/>
            <TextBlock Text="AETHERSHELL" Foreground="#FFFFFFFF" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Вход в сессию" Foreground="#B8A8B8" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,6,0,22"/>

            <StackPanel Name="LoginPanel" Visibility="Visible">
              <Border Style="{StaticResource InputBorderStyle}">
                <Grid Margin="14,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Path Data="{StaticResource IconApps}" Fill="#B8A8B8" Width="16" Height="16"
                        Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Логин" Foreground="{StaticResource TextGrayBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <TextBox Name="LoginUsername" Background="Transparent" BorderThickness="0"
                             FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                             Padding="0" CaretBrush="#FF5ED7"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Style="{StaticResource InputBorderStyle}">
                <Grid Margin="14,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Path Data="{StaticResource IconLock}" Fill="#B8A8B8" Width="16" Height="16"
                        Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Пароль" Foreground="{StaticResource TextGrayBrush}" FontSize="10" FontWeight="SemiBold"/>
                    <PasswordBox Name="LoginPassword" Background="Transparent" BorderThickness="0"
                                 FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                 Padding="0" CaretBrush="#FF5ED7"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Button Content="Забыли пароль?" HorizontalAlignment="Right" Margin="0,-4,0,8"
                      Background="Transparent" Foreground="#B8A8B8" BorderThickness="0"
                      FontSize="12" Cursor="Hand" Click="ShowRecovery_Click"
                      Style="{StaticResource NoHoverButtonStyle}"/>
