      <Geometry x:Key="IconLock">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</Geometry>
      <Geometry x:Key="IconExit">M12.75,31.5 H7.083 C6.332,31.5 5.611,31.184 5.08,30.621 C4.549,30.059 4.25,29.296 4.25,28.5 V7.5 C4.25,6.704 4.549,5.941 5.08,5.379 C5.611,4.816 6.332,4.5 7.083,4.5 H12.75 M22.667,10.5 L29.75,18 L22.667,25.5 M29.75,18 H12.75</Geometry>
      <Geometry x:Key="IconSwitchPc">M10.666,28 H21.333 M16,22.667 V28 M5.333,4 H26.666 C28.139,4 29.333,5.194 29.333,6.667 V20 C29.333,21.473 28.139,22.667 26.666,22.667 H5.333 C3.86,22.667 2.666,21.473 2.666,20 V6.667 C2.666,5.194 3.86,4 5.333,4 Z</Geometry>
      <Style x:Key="ChatAnimatedButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid>
                <Border Name="BtnBorder" Background="#342735" BorderBrush="#4FFFFFFF" BorderThickness="1" CornerRadius="25" Width="168" Height="56" Margin="0,0,-17,0" Padding="18,10" RenderTransformOrigin="1,0.5">
                  <UIElement.RenderTransform>
                    <TranslateTransform x:Name="MoveTransform" X="0" />
                  </UIElement.RenderTransform>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="💬" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Name="BtnText" Text="Чат с админом" Foreground="#FFFFFFFF" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                  </StackPanel>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="MoveTransform" Storyboard.TargetProperty="X" To="-14" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="MoveTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BtnBorder" Property="Border.Background" Value="#3C2F3D" />
                  <Setter TargetName="BtnBorder" Property="Border.BorderBrush" Value="#FF5ED7" />
                  <Setter TargetName="BtnText" Property="TextBlock.Foreground" Value="#FF5ED7" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="BtnBorder" Property="Border.Background" Value="#2A1F2B" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ChatScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollViewer}">
              <Grid>
                <ScrollContentPresenter />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NoHoverButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="UIElement.Opacity" Value="0.7" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModalButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="Bg" Background="#FC5ED8" CornerRadius="8" Padding="16,0">
                <Border.Effect>
                  <DropShadowEffect Color="#FB5ED8" BlurRadius="10" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="UIElement.Opacity" Value="0.92" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModalButtonSecondary" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="Bg" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="16,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextGrayBrush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShellIconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="Transparent">
                <Path Name="IconPath"
                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="Transparent"
                      Stroke="#F19EDC"
                      StrokeThickness="2.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Stretch="Uniform"
                      Width="22" Height="22"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="IconPath" Property="Stroke" Value="#FF5ED7" />
                  <Setter TargetName="IconPath" Property="UIElement.Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#F19EDC" BlurRadius="10" ShadowDepth="0" Opacity="0.7"/>
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShellImageButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Grid Background="#00FFFFFF">
                <Image Name="IconImage" Stretch="Uniform" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="IconImage" Property="UIElement.Effect">
                    <Setter.Value>
                      <DropShadowEffect Color="#FF5ED7" BlurRadius="10" ShadowDepth="0" />
                    </Setter.Value>
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ShellActiveButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="60" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="BtnBorder" CornerRadius="12">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#E6D395" Offset="0" />
                    <GradientStop Color="#BCA05A" Offset="0.5" />
                    <GradientStop Color="#7D6220" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <UIElement.Effect>
                  <DropShadowEffect Color="#FF5ED7" BlurRadius="20" ShadowDepth="0" Opacity="0.5" />
                </UIElement.Effect>
                <Path Fill="#FF000000" Stretch="Uniform" Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="BtnBorder" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InputBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0AFFFFFF" />
        <Setter Property="Border.CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
      </Style>
      <Style x:Key="AuthFieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#A299B8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="OldActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="Bd" CornerRadius="8" Padding="24,12">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FF375F" Offset="0"/>
                    <GradientStop Color="#BF5AF2" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                  <DropShadowEffect Color="#BF5AF2" BlurRadius="16" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="NeonLineStyle" TargetType="{x:Type Path}">
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Shape.Stretch" Value="Fill" />
        <Setter Property="Shape.StrokeStartLineCap" Value="Round" />
        <Setter Property="Shape.StrokeEndLineCap" Value="Round" />
        <Setter Property="UIElement.Effect">
          <Setter.Value>
            <BlurEffect Radius="25" KernelType="Gaussian" />
          </Setter.Value>
        </Setter>
      </Style>
      <LinearGradientBrush x:Key="GoldCardGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#EEDCA6" Offset="0.0" />
        <GradientStop Color="#FF5ED7" Offset="0.5" />
        <GradientStop Color="#BF9336" Offset="1.0" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Window.Resources>
