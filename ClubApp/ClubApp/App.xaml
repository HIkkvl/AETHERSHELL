<Application x:Class="AetherShell.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:AetherShell.Client.Utils"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <utils:ImageUrlConverter x:Key="ImageUrlConverter"/>

        <!-- Figma chat palette: #342735 / #3C2F3D / #FF5ED7 / white 31% -->
        <Color x:Key="ColorBg">#241820</Color>
        <Color x:Key="ColorPanel">#342735</Color>
        <Color x:Key="ColorGlass">#3C2F3D</Color>
        <Color x:Key="ColorAccent">#FF5ED7</Color>
        <Color x:Key="ColorAccentDeep">#E04BC0</Color>
        <Color x:Key="ColorAccentPurple">#8B3A7A</Color>
        <Color x:Key="ColorMuted">#B8A8B8</Color>
        <Color x:Key="ColorBorder">#4F4A50</Color>

        <!-- Legacy aliases (keep names used across XAML) -->
        <Color x:Key="ColorPrimaryGold">#FF5ED7</Color>
        <Color x:Key="ColorAccentGold">#E04BC0</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBg}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource ColorAccent}"/>
        <SolidColorBrush x:Key="PanelGlassBrush" Color="#CC342735"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorMuted}"/>
        <SolidColorBrush x:Key="TextWhiteBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorder}"/>

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF5ED7" Offset="0"/>
            <GradientStop Color="#8B3A7A" Offset="1"/>
        </LinearGradientBrush>

        <Geometry x:Key="IconClock">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</Geometry>
        <Geometry x:Key="IconArrowUp">M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z</Geometry>
        <Geometry x:Key="IconCheck">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</Geometry>
        <Geometry x:Key="IconSearch">M15.5,14L14.71,13.21C15.5,12 16,10.5 16,9C16,5.13 12.87,2 9,2C5.13,2 2,5.13 2,9C2,12.87 5.13,16 9,16C10.5,16 12,15.5 13.21,14.71L14,15.5V16L19,21L21,19L16,14M9,14C6.24,14 4,11.76 4,9C4,6.24 6.24,4 9,4C11.76,4 14,6.24 14,9C14,11.76 11.76,14 9,14Z</Geometry>
        <Geometry x:Key="IconGamepad">
            M 5,6 C 2.5,6 1,8 1,10.5 L 1,13 C 1,15.5 2.5,17.5 4.5,18 C 5.5,18.2 6.5,17.8 7,17 L 7.5,16 C 8,16 9,16 9.5,16.5 C 10,17 11,17 12,17 C 13,17 14,17 14.5,16.5 C 15,16 16,16 16.5,16 L 17,17 C 17.5,17.8 18.5,18.2 19.5,18 C 21.5,17.5 23,15.5 23,13 L 23,10.5 C 23,8 21.5,6 19,6 L 5,6 Z
